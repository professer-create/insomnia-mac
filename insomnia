#!/bin/bash
# insomnia — keep this Mac awake with the lid closed.
#
# Works on Intel and Apple Silicon Macs (macOS 12 and later) with no kernel
# extension. It flips macOS's own `pmset disablesleep` bit, the same mechanism
# krishhgg/Insomnia and Vorssaint use. Only this tool resets the bit
# (`insomnia off`, a timer, or the battery floor); macOS never does.
#
#   insomnia on            keep awake until `insomnia off`
#   insomnia on 8h         keep awake for 8 hours (30m, 2h, 1d also work)
#   insomnia off           back to normal sleep
#   insomnia status        what is going on right now
#   insomnia setup         print the one command that needs your password
#   insomnia backstop      run by launchd every minute: timer, battery floor,
#                          and re-apply if macOS flipped the bit back
#
# Needs a sudoers rule (written by `insomnia setup`) that lets this user run
# exactly two commands without a password:
#   /usr/bin/pmset -a disablesleep 1
#   /usr/bin/pmset -a disablesleep 0
set -u

USER_NAME="$(id -un)"
APP_SUPPORT="$HOME/Library/Application Support/Insomnia"
STATE="$APP_SUPPORT/session"      # one line: unix time the session ends; 0 = until turned off
LOG_DIR="$HOME/Library/Logs/Insomnia"
LOG="$LOG_DIR/insomnia.log"
SUDOERS_SRC="$APP_SUPPORT/sudoers.insomnia"
SUDOERS_DST="/etc/sudoers.d/insomnia"
PMSET=/usr/bin/pmset
SUDO=/usr/bin/sudo
VISUDO=/usr/sbin/visudo
BATTERY_FLOOR="${INSOMNIA_BATTERY_FLOOR:-10}"   # on battery, end the session at or below this %
SETTLE=5                                        # seconds to wait before reading the bit back

log() { mkdir -p "$LOG_DIR"; printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"; }
die() { echo "insomnia: $*" >&2; exit 1; }

usage() {
  sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
}

# Prints 1 when system sleep is disabled, else 0.
sleep_disabled() {
  "$PMSET" -g 2>/dev/null | awk '$1 == "SleepDisabled" { print $2; found = 1 } END { if (!found) print 0 }'
}

# True when the passwordless rule for both pmset commands is in place.
rule_installed() {
  "$SUDO" -n -l "$PMSET" -a disablesleep 1 >/dev/null 2>&1 &&
  "$SUDO" -n -l "$PMSET" -a disablesleep 0 >/dev/null 2>&1
}

setup_hint() {
  echo "  sudo install -o root -g wheel -m 0440 \"$SUDOERS_SRC\" $SUDOERS_DST"
}

write_sudoers_src() {
  mkdir -p "$APP_SUPPORT"
  rm -f "$SUDOERS_SRC"   # an earlier copy is mode 0440, so it cannot be overwritten in place
  printf '# Insomnia: let %s toggle system sleep without a password.\n%s ALL=(root) NOPASSWD: %s -a disablesleep 1, %s -a disablesleep 0\n' \
    "$USER_NAME" "$USER_NAME" "$PMSET" "$PMSET" > "$SUDOERS_SRC"
  chmod 0440 "$SUDOERS_SRC"
  "$VISUDO" -c -f "$SUDOERS_SRC" >/dev/null 2>&1 || die "generated sudoers rule failed validation"
}

# set_bit 1|0 — never prompts for a password; explains setup if the rule is missing.
set_bit() {
  local err
  if ! err="$("$SUDO" -n "$PMSET" -a disablesleep "$1" 2>&1)"; then
    log "pmset -a disablesleep $1 failed: $err"
    if [[ "$err" == *password* || "$err" == *sudo* ]]; then
      [ -f "$SUDOERS_SRC" ] || write_sudoers_src
      {
        echo "insomnia: not set up yet. Run this once in Terminal (it asks for your Mac password):"
        setup_hint
      } >&2
    else
      echo "insomnia: pmset failed: $err" >&2
    fi
    return 1
  fi
}

# parse_duration 30m|2h|1d|90 (minutes) -> seconds
parse_duration() {
  local v="$1" n unit
  [[ "$v" =~ ^([0-9]+)([mhd]?)$ ]] || return 1
  n="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[2]}"
  [ "$n" -gt 0 ] || return 1
  case "$unit" in
    ""|m) echo $(( n * 60 )) ;;
    h)    echo $(( n * 3600 )) ;;
    d)    echo $(( n * 86400 )) ;;
  esac
}

fmt_end() { date -r "$1" '+%a %d %b, %H:%M'; }

# Prints "<percent> ac|charging|discharging"
battery_info() {
  local out pct state
  out="$("$PMSET" -g batt 2>/dev/null)"
  pct="$(printf '%s' "$out" | grep -o -m1 '[0-9]\{1,3\}%' | tr -d '%')"
  if printf '%s' "$out" | grep -q "'AC Power'"; then state=ac
  elif printf '%s' "$out" | grep -q 'discharging'; then state=discharging
  else state=charging
  fi
  echo "${pct:-100} $state"
}

cmd_on() {
  local dur="${1:-}" secs end=0
  if [ -n "$dur" ]; then
    secs="$(parse_duration "$dur")" || die "bad duration '$dur' (try 30m, 2h, 1d)"
    end=$(( $(date +%s) + secs ))
  fi
  mkdir -p "$APP_SUPPORT"
  set_bit 1 || exit 2
  sleep "$SETTLE"
  if [ "$(sleep_disabled)" != 1 ]; then
    log "ON failed: macOS reverted SleepDisabled to 0 within ${SETTLE}s"
    die "macOS reverted the setting within ${SETTLE}s, so closing the lid would still sleep this Mac"
  fi
  printf '%s\n' "$end" > "$STATE"
  if [ "$end" = 0 ]; then
    log "ON until turned off"
    echo "Awake: this Mac keeps running with the lid closed until you run 'insomnia off'."
  else
    log "ON until $(fmt_end "$end")"
    echo "Awake: this Mac keeps running with the lid closed until $(fmt_end "$end")."
  fi
  echo "Keep it on a desk or stand, not in a bag. On battery it stops at ${BATTERY_FLOOR}%."
}

cmd_off() {
  local quiet="${1:-}"
  if [ "$(sleep_disabled)" = 1 ]; then
    set_bit 0 || exit 2
  fi
  rm -f "$STATE"
  log "OFF"
  [ -n "$quiet" ] || echo "Normal: closing the lid puts this Mac to sleep again."
}

cmd_status() {
  local bit end pct state
  bit="$(sleep_disabled)"
  if [ "$bit" = 1 ]; then
    echo "Awake: lid closed, Mac keeps running."
    if [ -f "$STATE" ]; then
      end="$(cat "$STATE")"
      if [ "$end" = 0 ]; then echo "Ends: when you run 'insomnia off'."; else echo "Ends: $(fmt_end "$end")"; fi
    else
      echo "Note: SleepDisabled is 1 but no insomnia session is recorded (set by something else)."
    fi
  else
    echo "Normal: lid closed, Mac sleeps."
    [ -f "$STATE" ] && echo "Note: a session file exists but sleep is enabled; the backstop fixes this within a minute."
  fi
  if rule_installed; then
    echo "Setup: done (passwordless pmset rule installed)."
  else
    [ -f "$SUDOERS_SRC" ] || write_sudoers_src
    echo "Setup: NOT done. Run once:"; setup_hint
  fi
  read -r pct state <<< "$(battery_info)"
  echo "Battery: ${pct}% ($state). Floor: ${BATTERY_FLOOR}%."
}

# Runs every minute from launchd. Only ever acts while a session file exists,
# so a bit set by something else is left alone.
cmd_backstop() {
  local now end bit pct state
  [ -f "$STATE" ] || exit 0
  now="$(date +%s)"
  end="$(cat "$STATE" 2>/dev/null || echo 0)"
  case "$end" in (*[!0-9]*|"") end=0 ;; esac
  bit="$(sleep_disabled)"
  if [ "$end" != 0 ] && [ "$now" -ge "$end" ]; then
    log "backstop: timer ended"
    cmd_off quiet
    exit 0
  fi
  read -r pct state <<< "$(battery_info)"
  if [ "$state" = discharging ] && [ "$pct" -le "$BATTERY_FLOOR" ]; then
    log "backstop: battery ${pct}% is at or below the ${BATTERY_FLOOR}% floor, ending session"
    cmd_off quiet
    exit 0
  fi
  if [ "$bit" != 1 ]; then
    if set_bit 1 2>/dev/null; then log "backstop: SleepDisabled had reverted to 0, re-applied"; fi
  fi
}

cmd_setup() {
  write_sudoers_src
  if rule_installed; then
    echo "Setup already done: the passwordless pmset rule is installed."
    return
  fi
  echo "Run this once in Terminal (it asks for your Mac password):"
  setup_hint
}

case "${1:-status}" in
  on)        cmd_on "${2:-}" ;;
  off)       cmd_off ;;
  status)    cmd_status ;;
  backstop)  cmd_backstop ;;
  setup)     cmd_setup ;;
  -h|--help|help) usage ;;
  *)         usage; exit 1 ;;
esac
